{
  "name": "@anthnyalxndr/gtm-model",
  "version": "0.1.0",
  "description": "The shared Google Tag Manager model: container types, container spec types, the Tag Manager API v2 Discovery types and the built-in variable and trigger catalog.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthnyalxndr/gtm_v2.git",
    "directory": "packages/gtm-model"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "gen:discovery": "tsx scripts/generate-discovery.ts",
    "probe:notes-cap": "tsx scripts/probe-notes-cap.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "google-tag-manager",
    "gtm",
    "tagmanager"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
