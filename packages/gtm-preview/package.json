{
  "name": "@anthnyalxndr/gtm-preview",
  "version": "0.1.0",
  "description": "Automated Google Tag Manager preview sessions over Playwright: capture dataLayer events and tag hits, predict what should have fired, and report mismatches.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gtm-preview": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "browsers": "playwright install chromium",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "fixture": "PORT=4173 tsx test/fixtures/site/serve.ts",
    "compare": "tsx scripts/compare-exports.ts"
  },
  "dependencies": {
    "@anthnyalxndr/gtm-client": "workspace:^",
    "@duckduckgo/autoconsent": "16.55.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
