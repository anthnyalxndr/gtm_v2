{
  "name": "gtm-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace for the @anthnyalxndr GTM packages: gtm-model, gtm-client, gtm-apply, gtm-recipes and gtm-preview.",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/*/scripts/**/*.ts\" \"packages/*/*.ts\"",
    "dev": "pnpm --filter @anthnyalxndr/gtm-apply dev",
    "prepare": "husky || true",
    "lint": "pnpm -r run lint"
  },
  "lint-staged": {
    "*.ts": "prettier --write",
    "packages/gtm-preview/**/*.{ts,mjs}": "pnpm --filter @anthnyalxndr/gtm-preview exec eslint --fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2"
}
