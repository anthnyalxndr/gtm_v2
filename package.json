{
  "name": "gtm-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace for @anthnyalxndr/gtm-client and @anthnyalxndr/gtm-apply.",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\" \"packages/*/*.ts\"",
    "dev": "pnpm --filter @anthnyalxndr/gtm-apply dev",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^20",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.30.2"
}
