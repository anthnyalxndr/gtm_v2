{
  "name": "@anthnyalxndr/gtm-apply",
  "version": "2.0.0",
  "description": "Declarative apply tool for Google Tag Manager: plan and reconcile a container against a JSON spec in the shape of a GTM container export.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "gtm-apply": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc && (husky || true)",
    "dev": "tsx example.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" example.ts",
    "verify": "pnpm typecheck && pnpm test"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  },
  "keywords": [
    "google-tag-manager",
    "gtm",
    "google-api",
    "tag-manager"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@googleapis/tagmanager": "^16.0.0",
    "google-auth-library": "^10.5.0",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
